{
  "name": "nur-oqiw-desktop",
  "version": "1.1.0",
  "private": true,
  "description": "Nur oqiw orayi Windows PC application",
  "main": "main.js",
  "author": "Nur oqiw orayi",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "45.4.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "uz.nuroqiworayi.desktop",
    "productName": "Nur Oqiw Orayi",
    "asar": true,
    "files": [
      "main.js",
      "offline.html",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "../download-site/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "requestedExecutionLevel": "asInvoker",
      "artifactName": "Nur_Oqiw_Setup.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Nur oqiw orayi",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Nur_Oqiw_Setup.exe",
      "warningsAsErrors": true
    }
  }
}
